{
  "datasets": [
    {
      "name": "641dc4a1",
      "displayName": "censo_2024_completo",
      "config": {
        "version": "1.1",
        "source": "genie_catalog.default.censo_2024_completo",
        "dimensions": [
          {
            "name": "region_nombre",
            "expr": "COALESCE(source.region_nombre, 'N/A')",
            "displayName": "Región"
          },
          {
            "name": "sexo_desc",
            "expr": "COALESCE(source.sexo_desc, 'N/A')",
            "displayName": "Género"
          },
          {
            "name": "edad",
            "expr": "source.edad",
            "displayName": "Edad"
          },
          {
            "name": "area_desc",
            "expr": "COALESCE(source.area_desc, 'N/A')",
            "displayName": "Tipo de Área"
          },
          {
            "name": "estado_civil_desc",
            "expr": "COALESCE(source.estado_civil_desc, 'N/A')",
            "displayName": "Estado Civil"
          },
          {
            "name": "sit_fuerza_trabajo_desc",
            "expr": "COALESCE(source.sit_fuerza_trabajo_desc, 'N/A')",
            "displayName": "Estado Laboral"
          },
          {
            "name": "tenencia_vivienda_desc",
            "expr": "COALESCE(source.tenencia_vivienda_desc, 'N/A')",
            "displayName": "Tenencia de Vivienda"
          },
          {
            "name": "nacionalidad_desc",
            "expr": "COALESCE(source.nacionalidad_desc, 'N/A')",
            "displayName": "Nacionalidad"
          },
          {
            "name": "autoid_pueblo_desc",
            "expr": "COALESCE(source.autoid_pueblo_desc, 'N/A')",
            "displayName": "Identidad Indígena"
          },
          {
            "name": "discapacidad_desc",
            "expr": "COALESCE(source.discapacidad_desc, 'N/A')",
            "displayName": "Estado de Discapacidad"
          },
          {
            "name": "servicio_internet_fija_desc",
            "expr": "COALESCE(source.servicio_internet_fija_desc, 'N/A')",
            "displayName": "Internet Fija"
          },
          {
            "name": "servicio_internet_movil_desc",
            "expr": "COALESCE(source.servicio_internet_movil_desc, 'N/A')",
            "displayName": "Internet Móvil"
          },
          {
            "name": "servicio_internet_satelital_desc",
            "expr": "COALESCE(source.servicio_internet_satelital_desc, 'N/A')",
            "displayName": "Internet Satelital"
          },
          {
            "name": "indice_hacinamiento_desc",
            "expr": "COALESCE(source.indice_hacinamiento_desc, 'N/A')",
            "displayName": "Índice de Hacinamiento"
          }
        ],
        "measures": [
          {
            "name": "total_population",
            "expr": "COUNT(*)",
            "displayName": "Población Total"
          },
          {
            "name": "poblacion",
            "expr": "COUNT(*)",
            "displayName": "Población"
          },
          {
            "name": "total_households",
            "expr": "COUNT(DISTINCT CONCAT(CAST(source.id_vivienda AS STRING), '-', CAST(source.id_hogar AS STRING)))",
            "displayName": "Total Hogares"
          },
          {
            "name": "total_dwellings",
            "expr": "COUNT(DISTINCT source.id_vivienda)",
            "displayName": "Total Viviendas"
          },
          {
            "name": "avg_persons_per_household",
            "expr": "CAST(COUNT(*) AS DOUBLE) / NULLIF(COUNT(DISTINCT CONCAT(CAST(source.id_vivienda AS STRING), '-', CAST(source.id_hogar AS STRING))), 0)",
            "displayName": "Promedio Personas por Hogar"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "ae83af6c",
      "displayName": "Análisis demográfico",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "## Censo Chile 2024 - Análisis Demográfico Integral\n",
                "\n",
                "Este dashboard proporciona una visión detallada del panorama demográfico de Chile basado en los datos del censo 2024. Explore la distribución de población por región, género, edad, áreas urbanas/rurales, estado civil, participación laboral, características de vivienda, nacionalidad, identidad indígena, estado de discapacidad y patrones de acceso a internet."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
